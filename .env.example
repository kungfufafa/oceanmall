APP_NAME=OceanMall
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Api Key List from https://collaborator.komerce.id/settings (click Show / Copy full key)
KOMERCE_SHIPPING_COST_API_KEY=
KOMERCE_SHIPPING_DELIVERY_API_KEY=
KOMERCE_PAYMENT_API_KEY=
# Optional — leave empty to skip QRISLY product and use Payment API QRIS instead
KOMERCE_QRISLY_API_KEY=
# Required only when QRISLY is enabled (from Collaborator upload-qris)
KOMERCE_QRISLY_QRIS_ID=
# KOMERCE_QRISLY_BASE_URL=https://api-sandbox.collaborator.komerce.id/user
# KOMERCE_QRISLY_UNIQUE_AMOUNT=true
# Optional legacy single-key fallback (tests / older setups). Prefer the four keys above.
# KOMERCE_API_KEY=
# Master switch for the Komerce collaborator integration (payment + RajaOngkir).
# Leave unset to auto-detect: enabled when any service API key is filled in.
# Set to false to force the whole integration off even if keys are present.
# KOMERCE_ENABLED=
KOMERCE_PAYMENT_BASE_URL=https://api-sandbox.collaborator.komerce.id/user
RAJAONGKIR_COST_BASE_URL=https://rajaongkir.komerce.id
RAJAONGKIR_DELIVERY_BASE_URL=https://api-sandbox.collaborator.komerce.id
RAJAONGKIR_COURIERS=jne,jnt,sicepat
# Not from the Api Key List — invent your own secret; sent as callback_API_KEY
# Payment callbacks verify X-Callback-Api-Key as HMAC-SHA256(raw body, this secret)
KOMERCE_WEBHOOK_SECRET=
KOMERCE_PICKUP_VEHICLE=Motor
KOMERCE_PICKUP_TIME=10:00
KOMERCE_TIMEOUT=30

# Stripe off by default — leave false unless you intentionally enable it
PAYMENT_STRIPE_ENABLED=false
PAYMENT_SANDBOX=false
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
