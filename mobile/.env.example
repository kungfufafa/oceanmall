# Laravel API v1. Simulator/emulator defaults are in lib/config.ts:
# iOS simulator  -> http://127.0.0.1:8000/api/v1
# Android emulator -> http://10.0.2.2:8000/api/v1
#
# Physical device: use your machine LAN IP, and bind artisan to 0.0.0.0
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
